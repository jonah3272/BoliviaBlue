{
  "redirects": [
    {
      "source": "/blue-dollar-bolivia",
      "destination": "/bolivian-blue",
      "permanent": true
    }
  ],
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/historical-data.csv",
      "destination": "/api/historical-data?format=csv"
    },
    {
      "source": "/api/historical-data.json",
      "destination": "/api/historical-data?format=json"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/rss-blog"
    },
    {
      "source": "/noticias/rss.xml",
      "destination": "/api/rss-news"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/rss-blog"
    },
    {
      "source": "/dolar-blue-hoy",
      "destination": "/dolar-blue-hoy/index.html"
    },
    {
      "source": "/dolar-paralelo-bolivia-en-vivo",
      "destination": "/dolar-paralelo-bolivia-en-vivo/index.html"
    },
    {
      "source": "/cuanto-esta-dolar-bolivia",
      "destination": "/cuanto-esta-dolar-bolivia/index.html"
    },
    {
      "source": "/bolivian-blue",
      "destination": "/bolivian-blue/index.html"
    },
    {
      "source": "/que-es-dolar-blue",
      "destination": "/que-es-dolar-blue/index.html"
    },
    {
      "source": "/datos-historicos",
      "destination": "/datos-historicos/index.html"
    },
    {
      "source": "/cotiza-dolar-paralelo",
      "destination": "/cotiza-dolar-paralelo/index.html"
    },
    {
      "source": "/preguntas-frecuentes",
      "destination": "/preguntas-frecuentes/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "framework": null
}
